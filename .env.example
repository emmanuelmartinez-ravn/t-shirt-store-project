# Postgres connection string (see docker/docker-compose.yaml for local dev credentials)
DATABASE_URL="postgresql://user:password@localhost:5432/tshirt_store?schema=public"

# HTTP server port
PORT=3000

# JWT signing secret used for access/refresh tokens
JWT_SECRET="change-me"

# Access token time-to-live, in minutes (default 15 if unset)
ACCESS_TOKEN_TTL=15

# Account activation token time-to-live, in minutes (default 30 if unset)
ACCOUNT_ACTIVATION_TOKEN_TTL=30

# Password reset token time-to-live, in minutes (default 30 if unset)
PASSWORD_RESET_TOKEN_TTL=30

# Redis connection, used by BullMQ (see docker/docker-compose.yaml for local dev)
REDIS_HOST=localhost
REDIS_PORT=6379

# SMTP connection, used by nodemailer to send account verification emails.
# For local dev, point these at a free SMTP catcher such as Mailtrap or Ethereal.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="no-reply@tshirt-store.com"

# Base URL used to build the (currently unimplemented) frontend's account
# activation link: `${FRONTEND_URL}/activation/{token}`
FRONTEND_URL="frontend.com"

# Credentials for the manager user created by `pnpm prisma db seed`
# (defaults to manager@tshirt-store.com / Manager123! if unset)
SEED_MANAGER_EMAIL="manager@tshirt-store.com"
SEED_MANAGER_PASSWORD="Manager123!"
